/tmp/

# ---------------------------------------------------------------------------
# Innovus / Genus run artifacts.
#
# A completed sram_axi run leaves ~180 MB behind: axi_ram_pnr.gds and
# axi_ram_pnr.def are ~60 MB each and saved/*.enc.dat another ~60 MB, all well
# past GitHub's 50 MB per-file limit.  Everything below is regenerated by
# rerunning the flow, so only the scripts and the small text reports are
# tracked.
# ---------------------------------------------------------------------------

# Design databases and streamed-out layout
**/saved/
**/outputs/*.gds
**/outputs/*.gds.gz
**/outputs/*.def
**/outputs/*.def.gz
**/outputs/*.oas
**/outputs/*.spef
**/outputs/*.fp
**/outputs/*.fp.spr

# Tool logs and session scratch
**/innovus.logv
**/innovus.cmd
**/genus.log
**/genus.cmd
**/*.log1/
**/.metrics/
**/pegasus_fill/
**/.timing_file_*.tif.gz
**/rc_model.bin
**/*.nfs_lock_flush
**/.rs_user1.tstamp
**/.stats.dat

# Timing exports: top_soc_pnr_{ss,ff}.sdf ~148 MB, vuot gioi han 100 MB cua GitHub
# (push bi tu choi 2026-09-17).  Tao lai bang KHOI 16 cua tcl/innovus.tcl.
**/outputs/*.sdf
**/outputs/*.sdf.gz
**/outputs/*.spef.gz

# Thu muc tam cua Innovus (rcdb, mmmc copy): 268 MB / 95 file sau mot lan route
**/innovus_temp_*/
**/*.rcdb.d/
**/extLogDir/
**/.cadence/

# optDesign/timeDesign khong co -outDir tu ghi vao day (hang tram file um*/)
**/timingReports/

# Log/cmd danh so cua cac phien cu (innovus.log chinh van duoc giu)
**/innovus.log[0-9]*
**/innovus.logv[0-9]*
**/innovus.cmd[0-9]*
**/genus.log[0-9]*
**/genus.cmd[0-9]*

# Report cu Innovus doi ten khi ghi de (*.rpt.old)
**/*.old

# Dofile LEC do Genus tu sinh
**/fv/

# Kept on purpose: tcl/, scripts/, reports/, verify_rpt/ and the handoff text
# reports, which are small and are the record of what a run produced.

# ---------------------------------------------------------------------------
# Vivado XSim run artifacts.
#
# run_soc_sim.sh bien dich toan bo RTL vao mot thu muc lam viec (mac dinh
# rtl/tests/sim_work): thu vien xsim.dir, wdb waveform va log cua xvlog/xelab.
# Tat ca deu tao lai duoc bang cach chay lai script.
# ---------------------------------------------------------------------------
**/tests/sim_work/
