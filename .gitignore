/tmp/

# ---------------------------------------------------------------------------
# Innovus / Genus run artifacts.
#
# A completed sram_axi run leaves ~180 MB behind: axi_ram_pnr.gds and
# axi_ram_pnr.def are ~60 MB each and saved/*.enc.dat another ~60 MB, all well
# past GitHub's 50 MB per-file limit.  Everything below is regenerated by
# rerunning the flow, so only the scripts and the small text reports are
# tracked.
# ---------------------------------------------------------------------------

# Design databases and streamed-out layout
**/saved/
**/outputs/*.gds
**/outputs/*.gds.gz
**/outputs/*.def
**/outputs/*.def.gz
**/outputs/*.oas
**/outputs/*.spef
**/outputs/*.fp
**/outputs/*.fp.spr

# Tool logs and session scratch
**/innovus.logv
**/innovus.cmd
**/genus.log
**/genus.cmd
**/*.log1/
**/.metrics/
**/pegasus_fill/
**/.timing_file_*.tif.gz
**/rc_model.bin
**/*.nfs_lock_flush
**/.rs_user1.tstamp
**/.stats.dat

# Timing exports: top_soc_pnr_{ss,ff}.sdf ~148 MB, vuot gioi han 100 MB cua GitHub
# (push bi tu choi 2026-09-17).  Tao lai bang KHOI 16 cua tcl/innovus.tcl.
**/outputs/*.sdf
**/outputs/*.sdf.gz
**/outputs/*.spef.gz

# Netlist gate-level do Genus/Innovus ghi ra.  Push bi tu choi lan 2 ngay
# 2026-09-20: outputs/top_soc_pnr_pg.v nang 168.95 MB (GH001).  Cac file khac
# cung dang to dan: top_soc_pnr.v 24 MB, top_soc_syn.v 20 MB,
# riscv_pipeline_pnr_pg.v 13.5 MB.  Tat ca tao lai duoc - Genus: write_hdl;
# Innovus: KHOI 16 (ban _pg co ca chan nguon).
# LUU Y: them dong nay KHONG go duoc file da lo commit.  Phai git rm --cached
# roi viet lai commit chua no, neu khong push van bi chan.
**/outputs/*.v
**/outputs/*.v.gz
**/outputs/
# Bao cao DRC sau metal fill: 279675 vi pham = 35.7 MB, va phinh lai sau moi
# run.  Tao lai bang KHOI 15.  Cac report khac trong verify_rpt van duoc giu.
# Thu muc tam cua Innovus (rcdb, mmmc copy): 268 MB / 95 file sau mot lan route
**/innovus_temp_*/
**/*.rcdb.d/
**/extLogDir/
**/.cadence/

# File tam cua Quantus / IQuantus khi extractRC chay tu Innovus (mcu/quantus).
# Chung nam trong thu muc chay Innovus, ten gan pid nen moi lan chay mot bo moi.
#   qrc_<pid>_<ngay>_HH:MM:SS_<n>.log   log rieng cua lenh qrc.  Ten co dau ':'
#       -> Windows khong tao duoc file, 'git pull' bao "invalid path" (commit
#       37a941e4 ngay 2026-10-09).  Noi dung da co trong quantus/logs/quantus.log.
#   .<pid>_<uuid>_soce_slave_<n>        script khoi tao cua tung tien trinh con
#   .<user>_launch_<pid>_<uuid>_<n>     script csh goi tien trinh con do
#   .cce.env.<pid>.<xxxxxx>             bien moi truong cua phien trich RC
**/qrc_*.log
**/.[0-9]*_soce_slave_[0-9]*
**/.*_launch_[0-9]*
**/.cce.env.*

# optDesign/timeDesign khong co -outDir tu ghi vao day (hang tram file um*/)
**/timingReports/

# Log/cmd danh so cua cac phien cu (innovus.log chinh van duoc giu)
**/innovus.log[0-9]*
**/innovus.logv[0-9]*
**/innovus.cmd[0-9]*
**/genus.log[0-9]*
**/genus.cmd[0-9]*

# Report cu Innovus doi ten khi ghi de (*.rpt.old)
**/*.old

# Dofile LEC do Genus tu sinh
**/fv/

# Thu muc tam cua Conformal (LEC.tmp.<pid>): netlist con ma hoa cua tung
# thread, chi co nghia khi tien trinh lec do con song.
**/LEC.tmp.*/

# Kept on purpose: tcl/, scripts/, reports/, verify_rpt/ and the handoff text
# reports, which are small and are the record of what a run produced.

# ---------------------------------------------------------------------------
# Vivado XSim run artifacts.
#
# run_soc_sim.sh bien dich toan bo RTL vao mot thu muc lam viec (mac dinh
# rtl/tests/sim_work): thu vien xsim.dir, wdb waveform va log cua xvlog/xelab.
# Tat ca deu tao lai duoc bang cach chay lai script.
# ---------------------------------------------------------------------------
**/tests/sim_work/
