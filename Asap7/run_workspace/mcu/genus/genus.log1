@file(genus.tcl) 243: create_opcond \
    -name opcond_tt_0p7v_25c \
    -process 1.0 \
    -voltage 0.7 \
    -temperature 25
@file(genus.tcl) 248: create_timing_condition \
    -name tc_tt \
    -library_sets libset_tt \
    -opcond opcond_tt_0p7v_25c
@file(genus.tcl) 252: create_delay_corner \
    -name dc_tt \
    -timing_condition tc_tt \
    -rc_corner rc_typ
@file(genus.tcl) 256: create_constraint_mode \
    -name mode_func \
    -sdc_files $SDC_FILE
@file(genus.tcl) 259: create_analysis_view \
    -name view_tt \
    -constraint_mode mode_func \
    -delay_corner dc_tt
@file(genus.tcl) 263: set_analysis_view -setup {view_tt} -hold {view_tt}
@file(genus.tcl) 265: foreach rtl $RTL_FILES {
    puts "Reading RTL: [file normalize $rtl]"
    read_hdl $rtl
}
