set sdc_version 2.0

set_units -capacitance 1fF
set_units -time 1ps

# Set the current design
current_design top_soc

create_clock -name "CLK_CORE" -period 2500.0 -waveform {0.0 1250.0} [get_ports clk_core]
create_clock -name "CLK_AXI" -period 5000.0 -waveform {0.0 2500.0} [get_ports clk_axi]
create_clock -name "CLK_APB" -period 10000.0 -waveform {0.0 5000.0} [get_ports clk_apb]
