set sdc_version 2.0

set_units -capacitance 1fF
set_units -time 1ps

# Set the current design
current_design top_soc

create_clock -name "CLK_SYS" -period 4000.0 -waveform {0.0 2000.0} [get_ports clk]
create_clock -name "CLK_TCK" -period 100000.0 -waveform {0.0 50000.0} [get_ports tck]
create_generated_clock -name "CLK_SDRAM_OUT" -divide_by 1  -invert   -source [get_ports clk]   [get_ports sdram_clk] 
create_generated_clock -name "CLK_CPU" -divide_by 1     -source [get_ports clk]   [get_pins cg_cpu/clk_out] 
create_generated_clock -name "CLK_DBG" -divide_by 1     -source [get_ports clk]   [get_pins cg_dbg/clk_out] 
create_generated_clock -name "CLK_PWM" -divide_by 1     -source [get_ports clk]   [get_pins cg_pwm/clk_out] 
create_generated_clock -name "CLK_GPIO" -divide_by 1     -source [get_ports clk]   [get_pins cg_gpio/clk_out] 
create_generated_clock -name "CLK_CORDIC" -divide_by 1     -source [get_ports clk]   [get_pins cg_cordic/clk_out] 
create_generated_clock -name "CLK_ASCON" -divide_by 1     -source [get_ports clk]   [get_pins cg_ascon/clk_out] 
create_generated_clock -name "CLK_UART" -divide_by 1     -source [get_ports clk]   [get_pins cg_uart/clk_out] 
create_generated_clock -name "CLK_SPI" -divide_by 1     -source [get_ports clk]   [get_pins cg_spi/clk_out] 
create_generated_clock -name "CLK_I2C" -divide_by 1     -source [get_ports clk]   [get_pins cg_i2c/clk_out] 
create_generated_clock -name "CLK_UART1" -divide_by 1     -source [get_ports clk]   [get_pins cg_uart1/clk_out] 
create_generated_clock -name "CLK_TIM0" -divide_by 1     -source [get_ports clk]   [get_pins cg_tim0/clk_out] 
create_generated_clock -name "CLK_TIM1" -divide_by 1     -source [get_ports clk]   [get_pins cg_tim1/clk_out] 
set_clock_transition -min 10.0 [get_clocks CLK_SYS]
set_clock_transition -max 40.0 [get_clocks CLK_SYS]
set_clock_transition -min 10.0 [get_clocks CLK_TCK]
set_clock_transition -max 40.0 [get_clocks CLK_TCK]
