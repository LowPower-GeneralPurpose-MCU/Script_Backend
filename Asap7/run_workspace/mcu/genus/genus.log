@file(genus.tcl) 378: foreach {master expected} $SRAM_MASTERS {
    set sram_cells {}
    set sram_copies 0
    foreach cell_obj [get_db lib_cells] {
        set leaf [file tail [get_db $cell_obj .name]]
        if {[string match "*$master*" $leaf]} {
            incr sram_copies
