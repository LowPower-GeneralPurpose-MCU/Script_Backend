@file(genus.tcl) 126: set boot_address 0
@file(genus.tcl) 127: set boot_entries {}
@file(genus.tcl) 128: set boot_seen [dict create]
@file(genus.tcl) 129: foreach line [split $boot_text "\n"] {
    regsub {//.*$} $line "" line
    regsub {#.*$} $line "" line
    foreach token [regexp -all -inline {\S+} $line] {
        if {[regexp {^@([0-9A-Fa-f]+)$} $token -> address_text]} {
            scan $address_text %x boot_address
            continue
        }
        regsub -all {_} $token "" word
        if {![regexp {^[0-9A-Fa-f]{1,8}$} $word]} {
            error "Invalid 32-bit boot ROM word '$token' in [file normalize $BOOT_MEM]"
        }
        if {$boot_address < 0 || $boot_address >= $BOOT_DEPTH} {
            error "Boot ROM address $boot_address is outside depth $BOOT_DEPTH"
        }
        if {[dict exists $boot_seen $boot_address]} {
            error "Duplicate boot ROM address $boot_address in [file normalize $BOOT_MEM]"
        }
        dict set boot_seen $boot_address 1
        lappend boot_entries [format "                %d: rom_lookup = 32'h%s;" $boot_address $word]
        incr boot_address
    }
}
@file(genus.tcl) 152: if {[llength $boot_entries] == 0} {
    error "Boot ROM image contains no data words: [file normalize $BOOT_MEM]"
}
@file(genus.tcl) 155: set fp [open "$BOOT_INCLUDE.tmp" w]
@file(genus.tcl) 156: puts $fp "// Generated from boot.mem by tcl/genus.tcl. Do not edit by hand."
@file(genus.tcl) 157: foreach entry $boot_entries {
    puts $fp $entry
}
@file(genus.tcl) 160: close $fp
@file(genus.tcl) 161: file rename -force "$BOOT_INCLUDE.tmp" $BOOT_INCLUDE
@file(genus.tcl) 162: puts "Pre-checks passed: $EXPECTED_RTL RTL files, macro budget 80 + 4, boot ROM [llength $boot_entries] words"
