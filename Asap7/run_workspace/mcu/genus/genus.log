}
@file(genus.tcl) 123: set BOOT_MEM     [file join $RTL_ROOT memory boot.mem]
@file(genus.tcl) 124: set BOOT_INCLUDE [file join $RTL_ROOT memory boot_rom_image.vh]
@file(genus.tcl) 125: set BOOT_DEPTH   8192
@file(genus.tcl) 126: set fp [open $BOOT_MEM r]
@file(genus.tcl) 127: set boot_text [read $fp]
@file(genus.tcl) 128: close $fp
@file(genus.tcl) 129: set boot_address 0
@file(genus.tcl) 130: set boot_entries {}
@file(genus.tcl) 131: set boot_seen [dict create]
@file(genus.tcl) 132: foreach line [split $boot_text "\n"] {
    regsub {//.*$} $line "" line
    regsub {#.*$} $line "" line
    foreach token [regexp -all -inline {\S+} $line] {
        if {[regexp {^@([0-9A-Fa-f]+)$} $token -> address_text]} {
            scan $address_text %x boot_address
            continue
        }
        regsub -all {_} $token "" word
        if {![regexp {^[0-9A-Fa-f]{1,8}$} $word]} {
            error "Invalid 32-bit boot ROM word '$token' in [file normalize $BOOT_MEM]"
        }
        if {$boot_address < 0 || $boot_address >= $BOOT_DEPTH} {
            error "Boot ROM address $boot_address is outside depth $BOOT_DEPTH"
        }
        if {[dict exists $boot_seen $boot_address]} {
            error "Duplicate boot ROM address $boot_address in [file normalize $BOOT_MEM]"
        }
        dict set boot_seen $boot_address 1
        lappend boot_entries [format "                %d: rom_lookup = 32'h%s;" $boot_address $word]
        incr boot_address
    }
}
@file(genus.tcl) 155: if {[llength $boot_entries] == 0} {
    error "Boot ROM image contains no data words: [file normalize $BOOT_MEM]"
}
@file(genus.tcl) 158: set fp [open "$BOOT_INCLUDE.tmp" w]
@file(genus.tcl) 159: puts $fp "// Generated from boot.mem by tcl/genus.tcl. Do not edit by hand."
@file(genus.tcl) 160: foreach entry $boot_entries {
    puts $fp $entry
}
@file(genus.tcl) 163: close $fp
@file(genus.tcl) 164: file rename -force "$BOOT_INCLUDE.tmp" $BOOT_INCLUDE
