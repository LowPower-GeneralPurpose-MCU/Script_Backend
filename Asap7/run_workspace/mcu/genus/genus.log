    dict set seen_rtl $rtl 1
    if {[file tail $rtl] in [list "$SRAM_MASTER.v" "$SRAM_TAG_MASTER.v"]} {
        error "Do not synthesize the behavioral SRAM model: $rtl"
    }
}
