@genus:root: 9> proc env_flag_is_true {name} {
    if {![info exists ::env($name)]} {
        return 0
    }

    set value [string tolower $::env($name)]
    return [expr {$value eq "1" || $value eq "true" || $value eq "yes" || $value eq "on"}]
}
