@file(genus.tcl) 267: set ALL_SEQS [all::all_seqs]
@file(genus.tcl) 269: set NON_DATA_INPUTS [get_ports [list clk rst_n]]
@file(genus.tcl) 271: set DATA_INPUTS \
    [remove_from_collection [all_inputs] $NON_DATA_INPUTS]
@file(genus.tcl) 274: if {[llength $ALL_SEQS] > 0} {
    define_cost_group -name I2C -design $TOP
    define_cost_group -name C2O -design $TOP
    define_cost_group -name C2C -design $TOP

    # Register-to-register paths
    path_group \
        -from  $ALL_SEQS \
        -to    $ALL_SEQS \
        -view  tt \
        -group C2C \
        -name  C2C

    # Register-to-output paths
    path_group \
        -from  $ALL_SEQS \
        -to    [all_outputs] \
        -view  tt \
        -group C2O \
        -name  C2O

    # Input-to-register paths
    if {[llength $DATA_INPUTS] > 0} {
        path_group \
            -from  $DATA_INPUTS \
            -to    $ALL_SEQS \
            -view  tt \
            -group I2C \
            -name  I2C
    }

    puts "===================================================="
    puts "COST GROUPS CREATED"
    puts " - C2C : register -> register"
    puts " - C2O : register -> output"
    puts " - I2C : input    -> register"
    puts " - View: tt"
    puts "===================================================="
} else {
    puts "WARNING: No sequential instances found; cost groups skipped."
}
